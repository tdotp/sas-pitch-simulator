# ─────────────────────────────────────────────────────────────
# Frontend environment. Copy to `.env.local` and fill in.
# Only PUBLIC Firebase web config goes here (safe to ship to the browser).
# NO ElevenLabs / OpenRouter keys — those live only in the backend.
# ─────────────────────────────────────────────────────────────

# Backend base URL. In dev, leave as /api (Vite proxies to localhost:8080).
VITE_API_BASE=/api

# Login credentials live directly in src/config.ts (APP_USERS), not in env
# vars — it's a small fixed team list, not per-environment config.

# ─── Firebase Web config (public) ───
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
