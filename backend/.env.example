# ─────────────────────────────────────────────────────────────
# SAS Pitch Simulator — Backend environment
# Copy this file to `.env` and fill in the real values.
# NEVER commit the real `.env`.
# ─────────────────────────────────────────────────────────────

# Server
PORT=8080
# Comma-separated list of allowed origins for CORS (frontend URLs)
CORS_ORIGINS=http://localhost:5173

# ─── ElevenLabs (Conversational AI / Agents) ───
# API key from https://elevenlabs.io  (Profile → API Keys)
ELEVENLABS_API_KEY=

# One Conversational AI Agent id. We override its prompt/voice/first-message
# per scenario at signed-url time, so a single agent covers the 3 modes.
ELEVENLABS_AGENT_ID=

# Voice IDs (from ElevenLabs → Voices). Must be es-CO / neutral LatAm,
# high-executive register. Fill after picking voices.
ELEVEN_VOICE_MALE=
ELEVEN_VOICE_FEMALE=
# Optional extra female/male options for the "random" generic mode.
ELEVEN_VOICE_GENERIC_A=
ELEVEN_VOICE_GENERIC_B=

# ─── OpenRouter (Claude Sonnet for evaluation) ───
OPENROUTER_API_KEY=
# Model slug on OpenRouter for Claude Sonnet.
OPENROUTER_MODEL=anthropic/claude-sonnet-4
# Optional attribution headers (recommended by OpenRouter)
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=SAS Pitch Simulator

# ─── Firebase Admin (service account) ───
# Path to the service-account JSON you downloaded from Firebase Console.
# Keep it OUTSIDE git (see .gitignore). Example: ./secrets/serviceAccount.json
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/serviceAccount.json
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# If true, backend runs without Firebase (logs to console instead of Firestore).
# Handy for local dev before Firebase is ready.
PERSISTENCE_DISABLED=false

# ─── Shared token (basic anti-abuse gate) ───
# Sent by the frontend on every /api call except /health. Not a real secret
# (it ships in the public JS bundle) — combined with the rate limiter, it
# just raises the bar above "anyone who finds the bare backend URL".
# Leave empty to disable the check (open, e.g. for quick local dev).
API_SHARED_TOKEN=

# AUTH_ALLOWED_EMAILS (Phase 1's temporary allowlist) was retired in
# Phase 3 — access control is now Organization/Membership (Firestore),
# not an env-var email list. See backend/src/config.ts and
# PHASE_03_TENANT_ISOLATION_RBAC_REPORT.md § ALLOWLIST_DECISION. To grant
# someone access, create their AppUser + Membership (see
# backend/scripts/bootstrap-phase2-legacy-org.ts for the pattern), not an
# env var.
